            },
            {
              "id": "url",
              "name": "url",
              "type": "string",
              "value": "={{ $json.body.url }}"
            },
            {
              "id": "body",
              "name": "body",
              "type": "string",
              "value": "={{ $json.body.body ?? \"\" }}"
            }
          ]
        }
      }
    }
