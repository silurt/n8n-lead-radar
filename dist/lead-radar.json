      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "leadId",
              "name": "leadId",
              "type": "string",
              "value": "={{ \"pushed:\" + $json.body.url }}"
            },
            {
              "id": "ats",
              "name": "ats",
              "type": "string",
              "value": "pushed"
            },
            {
              "id": "title",
              "name": "title",
              "type": "string",
              "value": "={{ $json.body.title }}"
            },
            {
              "id": "location",
