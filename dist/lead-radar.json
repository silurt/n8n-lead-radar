              "value": "={{ $(\"Draft outreach\").item.json.output?.text }}"
            },
            {
              "id": "verdict",
              "name": "verdict",
              "type": "string",
              "value": "ungrounded"
            },
            {
              "id": "assessments",
              "name": "assessments",
              "type": "string",
              "value": "={{ JSON.stringify($json.assessments ?? []) }}"
            }
          ]
        }
      }
    },
    {
      "id": "d73fe405-b797-42da-bca5-2169cdcb3ac6",
      "name": "Bedrock failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1300,
