            },
            {
              "id": "title",
              "name": "title",
              "type": "string",
              "value": "={{ $(\"Per lead\").item.json.title }}"
            },
            {
              "id": "url",
              "name": "url",
              "type": "string",
              "value": "={{ $(\"Per lead\").item.json.url }}"
            },
            {
              "id": "draft",
              "name": "draft",
              "type": "string",
              "value": "={{ $(\"Draft outreach\").item.json.output?.text }}"
            },
            {
              "id": "verdict",
              "name": "verdict",
              "type": "string",
              "value": "grounded"
            }
          ]
        }
      }
    },
    {
      "id": "4b3528fe-ad05-4223-a092-964579892a91",
      "name": "Per lead",
